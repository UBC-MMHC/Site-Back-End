{
  "$schema": "https://schema.railpack.com",
  "provider": "java",
  "packages": {
    "java": "21"
  },
  "steps": {
    "build": {
      "commands": [
        "...",
        "mkdir -p target && cp app/target/app-*.jar target/app.jar"
      ]
    }
  },
  "deploy": {
    "startCommand": "java -Dserver.port=${PORT:-8080} $JAVA_OPTS -jar target/app.jar"
  }
}
